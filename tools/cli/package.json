{
  "name": "@daaxar/cli",
  "version": "1.0.0",
  "description": "CLI para construir, desplegar y ejecutar Lambdas y servicios en AWS",
  "bin": {
    "Dx": "./bin/index.js"
  },
  "main": "dist/index.js",
  "scripts": {
    "prestart": "npm --silent run cli:build",
    "cli:build": "esbuild src/index.ts --bundle --external:esbuild --platform=node --target=node22 --format=cjs --outfile=dist/index.js",
    "cli:clean": "rimraf dist/*"
  },
  "devDependencies": {
    "@aws-sdk/core": "^3.846.0",
    "aws-cdk-lib": "^2.180.0",
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "dotenv": "^16.4.7",
    "esbuild": "^0.25.0",
    "inquirer": "^12.4.2",
    "shelljs": "^0.8.5"
  }
}
